# ============================================================================
# ECHO server settings.   Copy this file to ".env" and fill in the values.
# NEVER commit ".env" or share it. On Render / Railway you type these into the
# "Environment" page instead of using a file.
# ============================================================================

# ---------------------------- 1. REQUIRED -----------------------------------
# Supabase: Project Settings > API. Use the SECRET key (sb_secret_...), never the publishable one.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=sb_secret_xxxxxxxxxxxxxxxx

# Signs login tokens. Long random text (32+ characters). If you change it everyone is logged out.
# Make one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SERVER_SECRET=

# Password for the admin page (https://YOUR-SERVER/admin.html). Leave empty to switch admin OFF.
ADMIN_PASSWORD=

# On hosting set this to production. (The server then refuses to start without SERVER_SECRET.)
NODE_ENV=production

# ---------------------------- 2. EMAIL (OTP codes) --------------------------
# Pick ONE way to send mail. Many free hosts BLOCK SMTP, so use an API there.

# Option A - SMTP (Gmail App password, or any SMTP service). Works on your laptop and paid hosts.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=yourname@gmail.com
SMTP_PASS=your-16-letter-app-password
SMTP_FROM="Echo <yourname@gmail.com>"

# Option B - HTTPS email API (works everywhere, also on free hosting).
# MAIL_PROVIDER=brevo            # or resend  (auto-detected if only one key is set)
# BREVO_API_KEY=xkeysib-xxxxxxxx # Brevo: you must verify the sender address first
# RESEND_API_KEY=re_xxxxxxxx     # Resend: you must verify your own domain first
# MAIL_FROM_EMAIL=noreply@yourdomain.com
# MAIL_FROM_NAME=Echo

# Local testing only: print OTP codes in the console instead of sending an email.
# Ignored when NODE_ENV=production.
# OTP_DEV_LOG=1

# ---------------------------- 3. CALLS (TURN server) ------------------------
# Without TURN many calls between different mobile networks will NOT connect.
# Self-hosted coturn (see deploy/turnserver.conf): the secret must match coturn's static-auth-secret.
# TURN_URLS=turn:turn.yourdomain.com:3478?transport=udp,turn:turn.yourdomain.com:3478?transport=tcp
# TURN_SECRET=same-secret-as-in-turnserver.conf
# Or a hosted TURN service that gives a fixed username/password:
# TURN_USERNAME=
# TURN_CREDENTIAL=

# ---------------------------- 4. GOOGLE -------------------------------------
# Google Sign-In: Web client ID(s) from Google Cloud Console, comma separated.
# GOOGLE_CLIENT_IDS=1234567890-abc.apps.googleusercontent.com
# Play Billing verification: service account JSON (paste the whole JSON, or give a file path).
# GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account", ...}
# GOOGLE_SERVICE_ACCOUNT_FILE=/etc/secrets/play-service-account.json
ANDROID_PACKAGE_NAME=com.koshal.echotalk

# ---------------------------- 5. ADS ----------------------------------------
# Rewarded ad unit id (numbers after the slash in ca-app-pub-xxx/8634399335).
ADMOB_REWARDED_AD_UNIT=8634399335

# ---------------------------- 6. OPTIONAL TUNING ----------------------------
# PORT=3000                     # hosts set this by themselves
# TRUST_PROXY=1                 # set automatically on Render / Railway / Fly
# ALLOWED_ORIGINS=              # only for browser clients, e.g. https://yourwebsite.com
# GUEST_DURATION_MS=3600000     # guest allowance (60 minutes)
# REMATCH_COOLDOWN_MS=300000    # no re-match with the same stranger for 5 minutes
# OTP_RESEND_MS=45000           # gap between two OTP emails
# OTP_MAX_PER_HOUR=5            # OTP emails per address per hour
# ADMIN_RATE_PER_MIN=60         # admin API requests per minute per IP
# TERMS_VERSION=2026-10-22      # Terms and Conditions version. Change it ONLY together with
#                               # client/lib/constants/terms_text.dart: everyone is then asked to accept again.
# TERMS_ENFORCE=1               # 1 (default): nobody can match, buy coins or earn coins before accepting the Terms

# ---------------------------- 7. NOT USED BY THE APP ------------------------
# Phone (SMS) sign-in exists in the server but the app does not offer it. Leave empty.
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_VERIFY_SERVICE_SID=
