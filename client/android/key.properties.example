# Copy to android/key.properties (never commit it) and fill in your upload keystore.
# Create one with:  keytool -genkey -v -keystore ~/echo-upload.jks -keyalg RSA -keysize 2048 -validity 10000 -alias upload
storePassword=YOUR_STORE_PASSWORD
keyPassword=YOUR_KEY_PASSWORD
keyAlias=upload
storeFile=/absolute/path/to/echo-upload.jks
